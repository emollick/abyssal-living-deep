{
  "name": "abyssal-living-deep",
  "version": "3.2.0",
  "type": "module",
  "description": "A seeded underwater world beneath ABYSSAL's procedural ocean: coral reefs, kelp forests, marine life, volumetric light and a bioluminescent deep, with live generation and weather dials.",
  "license": "MIT",
  "author": "Davi (Token-Gremlin) <https://github.com/Token-Gremlin>",
  "homepage": "https://github.com/emollick/abyssal-living-deep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emollick/abyssal-living-deep.git"
  },
  "bugs": {
    "url": "https://github.com/emollick/abyssal-living-deep/issues"
  },
  "keywords": [
    "threejs",
    "webgl2",
    "glsl",
    "shaders",
    "ocean",
    "fft-ocean",
    "water-simulation",
    "volumetric-clouds",
    "atmospheric-scattering",
    "raymarching",
    "procedural-generation",
    "weather-simulation",
    "natural-disasters",
    "tsunami",
    "hurricane",
    "post-processing",
    "taa",
    "pbr",
    "real-time-rendering",
    "cinematic"

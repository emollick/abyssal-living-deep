    "preview": "vite preview --host",
    "test": "node tools/quality-sim.mjs && node tools/underwater-sim.mjs && node tools/connected-ocean-sim.mjs && node tools/fauna-sim.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
